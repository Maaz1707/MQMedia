# Copy to .env.local and fill in real values. See TODO_BEFORE_LAUNCH.md for
# what's still needed before this can go live.

# WhatsApp number the "Message us" links point to, digits only including
# country code (e.g. 919876543210 for an Indian +91 number). If unset or
# all zeros, the WhatsApp button/link is hidden rather than rendering a
# broken placeholder.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Contact email shown in the Contact section, footer and used in
# structured data. Defaults to hello@mqmedia.com if unset.
NEXT_PUBLIC_CONTACT_EMAIL=

# Canonical site URL used for metadataBase, canonical links, sitemap.xml
# and robots.txt. Falls back to the Vercel deployment URL automatically
# if unset, then to https://mqmedia.com as a last resort — set this once
# the real domain is live.
NEXT_PUBLIC_SITE_URL=

# The real total number of projects MQ Media has shipped, shown in the
# homepage "Projects Shipped" stat. Defaults to the number of projects
# actually shown in the Work section (currently 4) if unset — set this
# to the real, honest total once confirmed.
NEXT_PUBLIC_PROJECTS_SHIPPED_COUNT=

# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser).
# Resend API key used by /api/contact to actually deliver form
# submissions. Without this set, submissions are validated and logged
# server-side only — nothing is emailed. Get one at resend.com.
RESEND_API_KEY=

# The "From" address for contact-form emails. Must be on a domain
# verified in Resend, or omit to use Resend's shared test sender
# (onboarding@resend.dev), which works without domain verification but
# looks less official.
RESEND_FROM_EMAIL=

# Set to "false" to remove the "we'll get back to you within one
# business day" promise from the Contact section, if that commitment
# ever stops being realistic. Defaults to shown.
NEXT_PUBLIC_SHOW_RESPONSE_TIME_PROMISE=

# Region positioning fragment used in the hero eyebrow, meta description
# and footer (replaces the previous hardcoded "Worldwide"). Should read
# naturally as "...for trade businesses across India and the GCC" —
# quotes into sentences like "a design and growth studio {this}".
# Defaults to "for trade businesses across India and the GCC".
NEXT_PUBLIC_REGION_DESCRIPTOR=

# Trust signals shown in Contact and Footer. Both genuinely optional —
# unset means nothing renders (no placeholder text), not "TBD" or similar.
NEXT_PUBLIC_LOCATION=
NEXT_PUBLIC_PHONE=
